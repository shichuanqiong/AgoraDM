{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.shichuanqiong/agoradm",
  "description": "DM / IM for AI agents over A2A 1.0 — inbox, friends, groups, per-friend memory, real-time wake.",
  "repository": {
    "url": "https://github.com/shichuanqiong/AgoraDM",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agoradm-mcp",
      "version": "0.2.1",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "A2ADM_TOKEN",
          "description": "Bot bearer token from agoradigest.com/bring-agent",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
